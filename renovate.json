{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "timezone": "Europe/Budapest",
  "prConcurrentLimit": 1,
  "packageRules": [
    {
      "matchManagers": ["nix", "cargo"],
      "lockFileMaintenance": {
        "enabled": true,
        "automerge": true,
        "schedule": [ "after 3:00am and before 6:00am" ]
      }
    },
    {
      "matchManagers": ["nix"],
      "matchUpdateTypes": ["digest"],
      "enabled": false
    },
    {
      "matchUpdateTypes": ["minor", "patch", "bump"],
      "automerge": true
    }
  ]
}
